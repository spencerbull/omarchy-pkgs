# Maintainer: Spencer Bull <Spencer.Bull@Dell.com>
# Based on Arch Linux's kernel packaging and Omarchy's linux-ptl package.

pkgbase=linux-gb10
pkgver=6.17.13.nvidia1029
pkgrel=1
pkgdesc='NVIDIA GB10 kernel based on the qualified Ubuntu NVIDIA 6.17 lineage'
url='https://github.com/NVIDIA/NV-Kernels'
arch=(
  aarch64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  binutils
  bison
  cpio
  flex
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)
options=(
  !debug
  !lto
  !strip
)

_ubuntu_release=6.17.0-1029.29
_nvidia_tag=Ubuntu-nvidia-6.17-${_ubuntu_release}
# Signed tag object 20db7150caa3a91b449cf61aced89e8a70cbbe75, verified with
# Canonical key AE7D31FF19C227A5D7D425B1A08D6CD18E2BC802.
_commit=aea4c7df51fd59f7717d7668110a803d95c7a3f1
_srcname=NV-Kernels-${_commit}
source=(
  "${pkgbase}-${_commit}.tar.gz::https://codeload.github.com/NVIDIA/NV-Kernels/tar.gz/${_commit}"
  0001-libbpf-fix-c23-const.patch
  "${_nvidia_tag}.tag"
  "${_nvidia_tag}.tag.sig"
)
validpgpkeys=(
