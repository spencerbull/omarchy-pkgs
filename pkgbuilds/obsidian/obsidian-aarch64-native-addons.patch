-var binding = require('./binding.node');
+var execFile = require('child_process').execFile;
 
 module.exports = {
-  getFonts: () => binding.getFonts()
+  getFonts: () => new Promise((resolve, reject) => {
+    execFile('fc-list', ['--format', '%{family}\n'], { maxBuffer: 16 * 1024 * 1024 }, (error, stdout) => {
+      if (error) {
+        reject(error);
+        return;
+      }
+
+      var fonts = stdout
+        .split('\n')
+        .flatMap((family) => family.split(','))
+        .map((family) => family.trim())
+        .filter(Boolean);
+
+      resolve(Array.from(new Set(fonts)));
+    });
+  })
