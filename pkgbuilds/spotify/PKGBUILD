pkgname=spotify
pkgver='1.2.95.453'
epoch=1
_commit=g0eeebbed
pkgrel=2
pkgdesc='A proprietary music streaming service'
arch=('x86_64' 'aarch64')
license=('custom')
url='https://www.spotify.com'
depends_x86_64=('alsa-lib>=1.0.14' 'gtk3' 'libxss' 'desktop-file-utils' 'openssl' 'nss' 'at-spi2-atk' 'libcurl-gnutls' 'libsm' 'libayatana-appindicator')
depends_aarch64=('bash' 'chromium')
optdepends_x86_64=('ffmpeg4.4: Adds support for playback of local files'
                   'zenity: Adds support for importing local files'
                   'libnotify: Desktop notifications')
options=('!strip')

