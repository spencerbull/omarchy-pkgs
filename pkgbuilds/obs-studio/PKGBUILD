prepare() {
  cd "${pkgname}"

  git submodule init
  git config submodule."plugins/obs-browser".url "${srcdir}/${pkgname}-obs-browser"
  git config submodule."plugins/obs-websocket".url "${srcdir}/${pkgname}-obs-websocket"
  git config submodule."plugins/win-dshow/libdshowcapture".url \
    "${srcdir}/${pkgname}-libdshowcapture"
  git -c protocol.file.allow=always submodule update --init --recursive

  patch -Np1 -i "${srcdir}/obs-studio-aarch64-nvenc.patch"
}

build() {
  local nvcodec_root="${srcdir}/nv-codec-headers-n${_nvcodec_ver}"
  local source_prefix_map="-ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname}"
  sed "s|@@PREFIX@@|${nvcodec_root}|" \
    "${nvcodec_root}/ffnvcodec.pc.in" > "${nvcodec_root}/ffnvcodec.pc"
  export PKG_CONFIG_PATH="${nvcodec_root}${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
  export CFLAGS+=" ${source_prefix_map}"
  export CXXFLAGS+=" ${source_prefix_map}"

  local cmake_options=(
    -B build
    -S "${pkgname}"
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_COMPILE_WARNING_AS_ERROR=OFF
    -DCMAKE_INSTALL_PREFIX=/usr
    # mbedtls 4 is not supported yet: https://github.com/obsproject/obs-studio/issues/13601
    -DMbedTLS_INCLUDE_DIR=/usr/include/mbedtls3
    -DMbedcrypto_LIBRARY=/usr/lib/mbedtls3/libmbedcrypto.so
    -DMbedtls_LIBRARY=/usr/lib/mbedtls3/libmbedtls.so
    -DMbedx509_LIBRARY=/usr/lib/mbedtls3/libmbedx509.so
    # Arch Linux ARM does not publish CEF. The browser remains an explicit
    # optional split-package gap instead of being silently bundled or dropped.
    -DENABLE_BROWSER=OFF
    -DENABLE_VST=ON
    -DENABLE_VLC=OFF
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF
    -DENABLE_AJA=OFF
    -DENABLE_JACK=ON
    -DENABLE_LIBFDK=ON
    -DENABLE_WEBRTC=ON
    -DENABLE_WEBSOCKET=ON
    # ALARM's FFmpeg 9 package has no *_nvenc encoders. Build OBS's direct
    # NVENC plugin instead; Coleman runtime probes gate any support claim.
    -DENABLE_FFMPEG_NVENC=OFF
    -DENABLE_NVENC=ON
    # Driver 580.173.02 on GB10 exposes NVENC API 13.0. ALARM currently ships
    # 13.1 headers, which make the upstream capability helper reject that
    # driver before registering codecs. Pin the newest 13.0 headers instead.
    -DFFnvcodec_INCLUDE_DIR="${nvcodec_root}/include"
    -DOBS_VERSION_OVERRIDE="${pkgver}"
    -DCALM_DEPRECATION=ON
    -Wno-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --target obslua_swig_compilation obspython_swig_compilation

  # SWIG expands libobs's FILE_LINE macro while generating its wrappers, so
  # the compiler's -ffile-prefix-map cannot rewrite those two string literals.
  # Normalize only the generated wrappers before compiling them.
  local wrapper wrapper_count=0
  while IFS= read -r -d '' wrapper; do
    sed -i "s|${srcdir}|/usr/src/debug/${pkgname}|g" "$wrapper"
    if grep -Fq "${srcdir}" "$wrapper"; then
      printf 'Temporary source path remains in %s\n' "$wrapper" >&2
      return 1
    fi
    wrapper_count=$((wrapper_count + 1))
  done < <(find build/shared/obs-scripting -type f -name '*_wrap.*' -print0)
  ((wrapper_count == 2)) || {
    printf 'Expected two generated SWIG wrappers, found %d\n' "$wrapper_count" >&2
    return 1
  }

  cmake --build build
}

check() {
  local plugin=build/plugins/obs-nvenc/obs-nvenc.so
  local probe=build/plugins/obs-nvenc/obs-nvenc-test/obs-nvenc-test

  test -s "$plugin"
  test -x "$probe"
  file "$plugin" | grep -q 'ARM aarch64'
  file "$probe" | grep -q 'ARM aarch64'
  strings "$probe" | grep -q 'libnvidia-encode.so.1'
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
