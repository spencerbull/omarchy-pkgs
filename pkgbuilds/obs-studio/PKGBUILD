pkgname=obs-studio
pkgver=32.2.2
pkgrel=1
_nvcodec_ver=13.0.19.1
pkgdesc='Free, open source software for live streaming and recording'
arch=('aarch64')
url='https://obsproject.com'
license=('GPL-2.0-only')
depends=(
  'curl'
  'ffmpeg'
  'gtk-update-icon-cache'
  'jack'
  'jansson'
  'libdatachannel'
  'libxcomposite'
  'libxinerama'
