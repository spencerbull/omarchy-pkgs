  'qrcodegencpp-cmake'
  'qt6-svg'
  'rnnoise'
  'simde'
  'uthash'
)
makedepends=(
  'asio'
  'cmake'
  'extra-cmake-modules'
  'git'
  'libfdk-aac'
  'nlohmann-json'
  'sndio'
  'swig'
  'websocketpp'
  'x264'
)
optdepends=(
  'intel-media-driver: hardware encoding for recent Intel GPUs'
  'libfdk-aac: FDK AAC codec support'
  'libva-intel-driver: hardware encoding for older Intel GPUs'
  'libva-mesa-driver: VA-API hardware encoding'
  'nvidia-utils: NVIDIA NVENC hardware encoding runtime'
  'obs-studio-plugin-browser: CEF browser source (requires an AArch64 CEF package)'
  'sndio: Sndio input client'
  'v4l2loopback-dkms: virtual camera support'
  'xdg-desktop-portal-impl: Wayland window and screen capture'
)

source=(
  "${pkgname}::git+https://github.com/obsproject/obs-studio#tag=${pkgver}"
  "${pkgname}-libdshowcapture::git+https://github.com/obsproject/libdshowcapture.git"
  "${pkgname}-obs-browser::git+https://github.com/obsproject/obs-browser.git"
  "${pkgname}-obs-websocket::git+https://github.com/obsproject/obs-websocket.git"
  "nv-codec-headers-${_nvcodec_ver}.tar.gz::https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n${_nvcodec_ver}.tar.gz"
  'obs-studio-aarch64-nvenc.patch'
)
sha256sums=(
  '18edf1162e6cc37c192c4532ccfb902a07c5891d5929e95c4f028c6ad5d762d5'
  'SKIP'
  'SKIP'
  'SKIP'
  'c293161bd92dac53f2f8fab08abcd4f96773c3644a57b23c2260b4be2311ab2f'
